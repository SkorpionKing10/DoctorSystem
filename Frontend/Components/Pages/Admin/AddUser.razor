@page "/admin/users/add"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav

<div class="page-header">
    <h1>➕ Benutzer hinzufügen</h1>
    <p>Neuen Benutzer anlegen</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red;">Kein Zugriff.</p>
}
else
{
    <div class="form-card">

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">⚠️ @_errorMessage</div>
        }

        @if (_successMessage)
        {
            <div class="alert alert-success">✅ Benutzer wurde erfolgreich erstellt.</div>
        }

        <div class="form-group">
            <label>Benutzername</label>
            <input class="form-input"
                   @bind="_newUser.Username"
                   placeholder="Benutzername eingeben" />
        </div>

        <div class="form-group">
            <label>Passwort</label>
            <input class="form-input"
                   type="password"
                   @bind="_newUser.Password"
                   placeholder="Passwort eingeben" />
        </div>

        <div class="form-group">
            <label>Rolle</label>
            <select class="form-input" @bind="_newUser.Role">
                <option value="Staff">Staff</option>
                <option value="Admin">Admin</option>
                <option value="Doctor">Doctor</option>
            </select>
        </div>

        <div class="checkbox-row">
            <input type="checkbox" id="isActive" @bind="_newUser.IsActive" />
            <label for="isActive">Aktiv</label>
        </div>

        <div class="form-actions">
            <button class="btn-save" @onclick="SaveUser" disabled="@_isSaving">
                @(_isSaving ? "Speichern..." : "💾 Speichern")
            </button>
            <button class="btn-cancel" @onclick="Cancel">✖ Abbrechen</button>
        </div>

    </div>
}

@code {
    CreateUserDto _newUser = new() { IsActive = true, Role = "Staff" };
    string? _errorMessage;
    bool _successMessage = false;
    bool _isSaving = false;

    async Task SaveUser()
    {
        _errorMessage = null;
        _successMessage = false;

        if (string.IsNullOrWhiteSpace(_newUser.Username))
        {
            _errorMessage = "Benutzername darf nicht leer sein.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newUser.Password))
        {
            _errorMessage = "Passwort darf nicht leer sein.";
            return;
        }

        _isSaving = true;

        try
        {
            var result = await UserService.CreateUserAsync(_newUser);
            if (result != null)
            {
                _successMessage = true;
                await Task.Delay(1000);
                Nav.NavigateTo("/admin/users");
            }
            else
            {
                _errorMessage = "Fehler beim Erstellen des Benutzers.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Netzwerkfehler: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    void Cancel() => Nav.NavigateTo("/admin/users");
}