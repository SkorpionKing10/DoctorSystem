@page "/admin/patients/edit/{Id:int}"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IPatientService PatientService
@inject NavigationManager Nav

<div class="page-header">
    <h1>✏️ Patient bearbeiten</h1>
    <p>Patientendaten ändern</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else if (_patient == null)
{
    <p>Lade...</p>
}
else
{
    <div class="form-card">

        <div class="form-group">
            <label>Vorname</label>
            <input class="form-input" @bind="_patient.FirstName" />
        </div>

        <div class="form-group">
            <label>Nachname</label>
            <input class="form-input" @bind="_patient.LastName" />
        </div>

        <div class="form-group">
            <label>SV-Nummer</label>
            <input class="form-input" @bind="_patient.SocialSecurityNumber" />
        </div>

        <div class="form-group">
            <label>Geburtsdatum</label>
            <input type="date" class="form-input" @bind="_patient.BirthDate" />
        </div>

        <div class="form-actions">
            <button class="btn-save" @onclick="Save">💾 Änderungen speichern</button>
            <button class="btn-cancel" @onclick="Cancel">❌ Abbrechen</button>
        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    PatientDto? _patient;

    protected override async Task OnInitializedAsync()
    {
        _patient = await PatientService.GetPatientByIdAsync(Id);
    }

    async Task Save()
    {
        if (_patient == null) return;
        var success = await PatientService.UpdatePatientAsync(Id, _patient);
        if (success)
            Nav.NavigateTo("/admin/patients");
    }

    void Cancel() => Nav.NavigateTo("/admin/patients");
}