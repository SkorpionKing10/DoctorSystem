@page "/admin/appointments/new"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IAppointmentService AppointmentService
@inject IPatientService PatientService
@inject IConsultationHourService ConsultationHourService
@inject NavigationManager Nav

<div class="page-header">
    <h1>➕ Termin vergeben</h1>
    <p>Neuen Termin erstellen</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else
{
    <div class="form-card" style="max-width:500px;">

        <div class="form-group">
            <label>Patient</label>
            <select class="form-input" @bind="_selectedPatientId">
                <option value="0">-- Patient wählen --</option>
                @foreach (var p in _patients)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Sprechstunde</label>
            <select class="form-input"
                    @bind="_selectedConsultationHourId"
                    @bind:after="LoadFreeSlots">
                <option value="0">-- Sprechstunde wählen --</option>
                @foreach (var c in _consultationHours)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Datum</label>
            <input type="date"
                   class="form-input"
                   @bind="_selectedDate"
                   @bind:after="LoadFreeSlots" />
        </div>

        @if (_freeSlots.Any())
        {
            <div class="form-group">
                <label>Freie Zeitslots</label>
                <select class="form-input" @bind="_selectedTime">
                    <option value="">-- Zeit wählen --</option>
                    @foreach (var s in _freeSlots)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
        }
        else if (_selectedConsultationHourId > 0)
        {
            <p style="color:#888; font-size:13px;">
                Keine freien Slots an diesem Tag.
            </p>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_success ? "alert-success" : "alert-error")">
                @(_success ? "✅" : "⚠️") @_message
            </div>
        }

        <div class="form-actions">
            <button class="btn-save" @onclick="BookAppointment">✅ Termin buchen</button>
            <button class="btn-cancel"
                    @onclick="@(() => Nav.NavigateTo("/admin/appointments"))">
                ❌ Abbrechen
            </button>
        </div>

    </div>
}

@code {
    List<PatientDto> _patients = new();
    List<ConsultationHourDto> _consultationHours = new();
    List<string> _freeSlots = new();

    int _selectedPatientId = 0;
    int _selectedConsultationHourId = 0;
    DateTime _selectedDate = DateTime.Today;
    string _selectedTime = "";
    string _message = "";
    bool _success = false;

    protected override async Task OnInitializedAsync()
    {
        _patients = await PatientService.GetAllPatientsAsync();
        _consultationHours = await ConsultationHourService.GetAllAsync();
    }

    async Task LoadFreeSlots()
    {
        if (_selectedConsultationHourId == 0) return;
        _freeSlots = await AppointmentService.GetFreeSlotsAsync(_selectedConsultationHourId, _selectedDate);
    }

    async Task BookAppointment()
    {
        if (_selectedPatientId == 0 || _selectedConsultationHourId == 0 || string.IsNullOrEmpty(_selectedTime))
        {
            _message = "Bitte alle Felder ausfüllen.";
            _success = false;
            return;
        }

        var dto = new AppointmentCreateDto
        {
            PatientId = _selectedPatientId,
            ConsultationHourId = _selectedConsultationHourId,
            Date = _selectedDate,
            Time = TimeSpan.Parse(_selectedTime)
        };

        var result = await AppointmentService.CreateAppointmentAsync(dto);
        if (result != null)
        {
            _message = "Termin erfolgreich gebucht!";
            _success = true;
            _selectedTime = "";
            await LoadFreeSlots();
        }
        else
        {
            _message = "Fehler beim Buchen.";
            _success = false;
        }
    }
}