@page "/admin/patient/new"
@rendermode InteractiveServer
@using Frontend.Models
@inject HttpClient Http
@inject NavigationManager Nav

<h1>Neuen Patienten erstellen</h1>

<div class="form-container">

    <div class="form-group">
        <label>Vorname</label>
        <input @bind="patient.FirstName" />
    </div>

    <div class="form-group">
        <label>Nachname</label>
        <input @bind="patient.LastName" />
    </div>

    <div class="form-group">
        <label>SV-Nummer</label>
        <input @bind="patient.SocialSecurityNumber" />
    </div>

    <div class="form-group">
        <label>Geburtsdatum</label>
        <input type="date" @bind="patient.BirthDate" />
    </div>

    <div class="button-row">
        <button class="save-btn" @onclick="Save">
            💾 Speichern
        </button>

        <button class="cancel-btn" @onclick="Cancel">
            ❌ Abbrechen
        </button>
    </div>

</div>

@code {

    Patient patient = new()
    {
        BirthDate = DateTime.Now
    };

    async Task Save()
    {
        var result = await Http.PostAsJsonAsync(
            "http://192.168.68.102:5040/api/patients",
            patient);

        if (result.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/admin/patient");
        }
    }

    void Cancel()
    {
        Nav.NavigateTo("/admin/patient");
    }
}