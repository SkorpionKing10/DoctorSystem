@page "/admin/patients/new"
@layout ProtectedLayout

@using Frontend.Models
@using Frontend.Services

@inject IAuthService Auth
@inject IPatientService PatientService
@inject NavigationManager Nav

<div class="page-header">
    <h1>➕ Neuen Patienten erstellen</h1>
    <p>Neuen Patienten hinzufügen</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else
{
    <div class="form-card">

        <div class="form-group">
            <label>Vorname</label>
            <input class="form-input" @bind="_patient.FirstName" />
        </div>

        <div class="form-group">
            <label>Nachname</label>
            <input class="form-input" @bind="_patient.LastName" />
        </div>

        <div class="form-group">
            <label>SV-Nummer</label>
            <input class="form-input" @bind="_patient.SocialSecurityNumber" />
        </div>

        <div class="form-group">
            <label>Geburtsdatum</label>
            <input type="date" class="form-input" @bind="_patient.BirthDate" />
        </div>

        <div class="form-actions">
            <button class="btn-save" @onclick="Save">
                💾 Speichern
            </button>

            <button class="btn-cancel" @onclick="Cancel">
                ❌ Abbrechen
            </button>
        </div>

    </div>
}

@code
{
    private PatientDto _patient = new()
    {
        BirthDate = DateTime.Now
    };

    private async Task Save()
    {
        var result = await PatientService.CreatePatientAsync(_patient);

        if (result != null)
        {
            Nav.NavigateTo("/admin/patient");
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/admin/patient");
    }
}