@page "/admin/patients"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IPatientService PatientService
@inject NavigationManager Nav

<div class="page-header">
    <h1>🧑 Patientenverwaltung</h1>
    <p>Alle registrierten Patienten</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else if (patients == null)
{
    <p>Lade...</p>
}
else
{
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <div class="section-title">@patients.Count Patienten</div>
        <button class="appt-badge" @onclick="CreateNew">➕ Neuer Patient</button>
    </div>

    @foreach (var p in patients)
    {
        <div class="patient-card">
            <div class="patient-avatar">
                @(p.FirstName[0].ToString().ToUpper())@(p.LastName[0].ToString().ToUpper())
            </div>
            <div style="flex:1">
                <div class="patient-name">@p.FirstName @p.LastName</div>
                <div class="patient-svn">SVN: @p.SocialSecurityNumber · @p.BirthDate.ToString("dd.MM.yyyy")</div>
            </div>
            <div style="display:flex; gap:8px;">
                <button class="appt-badge" @onclick="() => EditPatient(p.Id)">✏️ Bearbeiten</button>
                <button class="appt-badge cancelled" @onclick="() => DeletePatient(p.Id)">🗑 Löschen</button>
            </div>
        </div>
    }
}

@code {
    List<PatientDto>? patients;

    protected override async Task OnInitializedAsync()
    {
        patients = await PatientService.GetAllPatientsAsync();
    }

    void CreateNew() => Nav.NavigateTo("/admin/patients/new");
    void EditPatient(int id) => Nav.NavigateTo($"/admin/patients/edit/{id}");

    async Task DeletePatient(int id)
    {
        var success = await PatientService.DeletePatientAsync(id);
        if (success)
            patients?.RemoveAll(x => x.Id == id);
    }
}