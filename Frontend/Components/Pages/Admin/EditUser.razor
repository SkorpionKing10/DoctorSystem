@page "/admin/users/edit/{Id:int}"
@layout ProtectedLayout
@inject HttpClient Http
@inject NavigationManager Nav
@using Frontend.Services
@using Frontend.Models
@inject AuthService Auth

<div class="page-header">
    <h1>✏️ User bearbeiten</h1>
    <p>Benutzerdaten ändern</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else if (user == null)
{
    <p>Lade...</p>
}
else
{
    <div class="patient-card" style="flex-direction:column; align-items:stretch; gap:10px;">

        <label>Username</label>
        <input @bind="user.Username" />

        <label>Rolle</label>
        <select @bind="user.Role">
            <option value="Admin">Admin</option>
            <option value="Doctor">Doctor</option>
            <option value="Staff">Staff</option>
        </select>

        <label style="display:flex; gap:8px; align-items:center; margin-top:10px;">
            <input type="checkbox" @bind="user.IsActive" />
            Aktiv
        </label>

        <div style="display:flex; gap:10px; margin-top:15px;">

            <button class="appt-badge" @onclick="SaveUser">
                💾 Speichern
            </button>

            <button class="appt-badge cancelled" @onclick="GoBack">
                ❌ Abbrechen
            </button>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    UserDto? user;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await Http.GetFromJsonAsync<List<UserDto>>(
                "http://localhost:5264/api/users");

            user = users?.FirstOrDefault(x => x.Id == Id);
        }
        catch
        {
            user = null;
        }
    }

    async Task SaveUser()
    {
        if (user == null) return;

        await Http.PutAsJsonAsync(
            $"http://localhost:5264/api/users/{user.Id}",
            new UpdateUserDto
            {
                Username = user.Username,
                Role = Enum.Parse<UserRole>(user.Role),
                IsActive = user.IsActive
            });

        Nav.NavigateTo("/admin/users");
    }

    void GoBack()
    {
        Nav.NavigateTo("/admin/users");
    }

    public class UserDto
    {
        public int Id { get; set; }
        public string Username { get; set; } = "";
        public string Role { get; set; } = "";
        public bool IsActive { get; set; }
    }

    public class UpdateUserDto
    {
        public string Username { get; set; } = "";
        public UserRole Role { get; set; }
        public bool IsActive { get; set; }
    }

    public enum UserRole
    {
        Admin,
        Doctor,
        Staff
    }
}