@page "/admin/users/edit/{Id:int}"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav

<div class="page-header">
    <h1>✏️ User bearbeiten</h1>
    <p>Benutzerdaten ändern</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else if (_user == null)
{
    <p>Lade...</p>
}
else
{
    <div class="form-card" style="max-width:500px;">

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">⚠️ @_errorMessage</div>
        }

        @if (_successMessage)
        {
            <div class="alert alert-success">✅ Benutzer erfolgreich aktualisiert!</div>
        }

        <div class="form-group">
            <label>Username</label>
            <input class="form-input" @bind="_user.Username" />
        </div>

        <div class="form-group">
            <label>Rolle</label>
            <select class="form-input" @bind="_user.Role">
                <option value="Admin">Admin</option>
                <option value="Doctor">Doctor</option>
                <option value="Staff">Staff</option>
            </select>
        </div>

        <div class="checkbox-row">
            <input type="checkbox" id="isActive" @bind="_user.IsActive" />
            <label for="isActive">Aktiv</label>
        </div>

        <div class="form-actions">
            <button class="btn-save" @onclick="SaveUser" disabled="@_isSaving">
                @(_isSaving ? "Speichern..." : "💾 Speichern")
            </button>
            <button class="btn-cancel" @onclick="GoBack">❌ Abbrechen</button>
        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    UserDto? _user;
    string? _errorMessage;
    bool _successMessage = false;
    bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"Users/Edit: Loading user {Id}");
        _user = await UserService.GetUserByIdAsync(Id);

        if (_user == null)
        {
            Console.WriteLine($"Users/Edit: User {Id} not found");
            _errorMessage = "Benutzer nicht gefunden.";
        }
        else
        {
            Console.WriteLine($"Users/Edit: Loaded user {_user.Username}");
        }
    }

    async Task SaveUser()
    {
        _errorMessage = null;
        _successMessage = false;

        if (_user == null)
        {
            _errorMessage = "Benutzer nicht geladen.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_user.Username))
        {
            _errorMessage = "Benutzername darf nicht leer sein.";
            return;
        }

        _isSaving = true;

        try
        {
            var dto = new UpdateUserDto
            {
                Username = _user.Username,
                Role = _user.Role,
                IsActive = _user.IsActive
            };

            Console.WriteLine($"SaveUser: Updating user {Id}");
            var success = await UserService.UpdateUserAsync(Id, dto);

            if (success)
            {
                Console.WriteLine($"SaveUser: Success");
                _successMessage = true;
                await Task.Delay(1500);
                Nav.NavigateTo("/admin/users");
            }
            else
            {
                _errorMessage = "Fehler beim Speichern. Bitte erneut versuchen.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SaveUser Exception: {ex.Message}");
            _errorMessage = $"Fehler: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    void GoBack()
    {
        Nav.NavigateTo("/admin/users");
    }
}