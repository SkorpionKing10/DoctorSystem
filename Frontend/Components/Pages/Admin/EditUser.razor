@page "/admin/users/edit/{Id:int}"
@layout ProtectedLayout
@using Frontend.Models
@using Frontend.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav

<div class="page-header">
    <h1>✏️ User bearbeiten</h1>
    <p>Benutzerdaten ändern</p>
</div>

@if (!Auth.IsAdmin)
{
    <p style="color:red">Kein Zugriff.</p>
}
else if (_user == null)
{
    <p>Lade...</p>
}
else
{
    <div class="patient-card" style="flex-direction:column; align-items:stretch; gap:10px;">

        <label>Username</label>
        <input @bind="_user.Username" />

        <label>Rolle</label>
        <select @bind="_user.Role">
            <option value="Admin">Admin</option>
            <option value="Doctor">Doctor</option>
            <option value="Staff">Staff</option>
        </select>

        <label style="display:flex; gap:8px; align-items:center; margin-top:10px;">
            <input type="checkbox" @bind="_user.IsActive" />
            Aktiv
        </label>

        <div style="display:flex; gap:10px; margin-top:15px;">
            <button class="appt-badge" @onclick="SaveUser">💾 Speichern</button>
            <button class="appt-badge cancelled" @onclick="GoBack">❌ Abbrechen</button>
        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    UserDto? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserService.GetUserByIdAsync(Id);
    }

    async Task SaveUser()
    {
        if (_user == null) return;

        var dto = new UpdateUserDto
        {
            Username = _user.Username,
            Role = _user.Role,
            IsActive = _user.IsActive
        };

        await UserService.UpdateUserAsync(Id, dto);
        Nav.NavigateTo("/admin/users");
    }

    void GoBack() => Nav.NavigateTo("/admin/users");
}