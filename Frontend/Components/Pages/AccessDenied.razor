@page "/access-denied"
@layout Layout.LoginLayout

<div class="login-box">
    <h1>⛔ Kein Zugriff</h1>
    <p style="color:#555; text-align:center;">
        Dein Windows-Account hat keinen Zugriff auf dieses System.<br />
        Bitte wende dich an den Administrator.
    </p>
    <p style="font-size:12px; color:#aaa; text-align:center;">
        Stelle sicher dass du mit einem Domain-Account angemeldet bist.
    </p>
</div>