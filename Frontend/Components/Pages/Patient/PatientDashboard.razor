@page "/patient/dashboard"
@layout ProtectedLayout
@using Frontend.Services
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav

<div class="page-header">
    <h1>📅 Meine Termine</h1>
    <p>Willkommen, <b>@Auth.Username</b></p>
</div>

@* Zugriff: nur Staff (= Patient) darf diese Seite sehen *@
@if (!Auth.IsStaff)
{
    <p style="color:red;">Kein Zugriff.</p>
}
else if (!_initialized)
{
    <p>Lade...</p>
}
else if (_patientId == 0)
{
    <p style="color:orange;">⚠️ Kein verknüpfter Patient gefunden. Bitte wende dich an die Praxis.</p>
}
else
{
    <!-- Statistik -->
    <div class="stats">
        <div class="stat-card">
            <div class="label">Meine Termine</div>
            <div class="value">@_appointments.Count</div>
        </div>
        <div class="stat-card">
            <div class="label">Zukünftige</div>
            <div class="value">@_appointments.Count(a => a.Date.Date >= DateTime.Today)</div>
        </div>
    </div>

    <!-- Termin buchen -->
    <div class="section-title">Neuen Termin buchen</div>
    <div class="form-card" style="margin-bottom:24px;">

        @if (!string.IsNullOrEmpty(_bookingError))
        {
            <div class="alert alert-error">⚠️ @_bookingError</div>
        }
        @if (_bookingSuccess)
        {
            <div class="alert alert-success">✅ Termin erfolgreich gebucht!</div>
        }

        <div class="form-group">
            <label>Sprechstunde</label>
            <select class="form-input"
                    @bind="_selectedConsultationHourId"
                    @bind:after="LoadFreeSlots">
                <option value="0">-- Sprechstunde wählen --</option>
                @foreach (var c in _consultationHours)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Datum</label>
            <input type="date"
                   class="form-input"
                   @bind="_selectedDate"
                   @bind:after="LoadFreeSlots" />
        </div>

        @if (_freeSlots.Any())
        {
            <div class="form-group">
                <label>Freier Zeitslot</label>
                <select class="form-input" @bind="_selectedTime">
                    <option value="">-- Zeit wählen --</option>
                    @foreach (var s in _freeSlots)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
        }
        else if (_selectedConsultationHourId > 0)
        {
            <p style="color:#888; font-size:13px;">Keine freien Slots an diesem Tag.</p>
        }

        <div class="form-actions">
            <button class="btn-save"
                    @onclick="BookAppointment"
                    disabled="@_isBooking">
                @(_isBooking ? "Buchen..." : "✅ Termin buchen")
            </button>
        </div>
    </div>

    <!-- Terminliste -->
    <div class="section-title">Meine gebuchten Termine</div>

    @if (!_appointments.Any())
    {
        <p style="color:#888;">Keine Termine vorhanden.</p>
    }
    else
    {
        @foreach (var a in _appointments.OrderBy(x => x.Date).ThenBy(x => x.Time))
        {
            <div class="appointment-card">
                <div class="appt-avatar">
                    @(a.Date.Day.ToString("D2"))
                </div>
                <div class="appt-info">
                    <div class="appt-name">@a.ConsultationHourName</div>
                    <div class="appt-detail">
                        @a.Date.ToString("dd.MM.yyyy") · @a.Time.ToString(@"hh\:mm") Uhr
                    </div>
                    <div class="appt-detail" style="font-size:12px; color:#888;">
                        @a.DoctorName
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                    <span class="appt-badge">Bestätigt</span>
                    @if (a.Date.Date >= DateTime.Today)
                    {
                        <button class="appt-badge cancelled"
                                style="cursor:pointer; border:none;"
                                disabled="@(_cancellingId == a.Id)"
                                @onclick="() => CancelAppointment(a.Id)">
                            @(_cancellingId == a.Id ? "..." : "❌ Absagen")
                        </button>
                    }
                </div>
            </div>
        }
    }

    <!-- Bestätigungs-Dialog -->
    @if (_confirmCancelId.HasValue)
    {
        <div style="position:fixed; inset:0; background:rgba(0,0,0,0.4);
            display:flex; align-items:center; justify-content:center; z-index:1000;">
            <div style="background:white; border-radius:12px; padding:24px;
                max-width:360px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
                <h3 style="margin:0 0 12px;">Termin absagen?</h3>
                <p style="color:#555; margin:0 0 20px;">
                    Möchtest du diesen Termin wirklich absagen?
                    Der Slot wird wieder freigegeben.
                </p>
                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button class="btn-cancel" @onclick="DismissCancel">Zurück</button>
                    <button class="appt-badge cancelled"
                            style="cursor:pointer; border:none; padding:8px 16px;"
                            @onclick="ConfirmCancel">
                        Ja, absagen
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_cancelMessage))
    {
        <div class="alert @(_cancelSuccess ? "alert-success" : "alert-error")"
             style="margin-top:12px;">
            @(_cancelSuccess ? "✅" : "⚠️") @_cancelMessage
        </div>
    }
}

@code {
    int _patientId = 0;
    bool _initialized = false;

    List<PatientAppointmentDto> _appointments = new();
    List<ConsultationHourDto> _consultationHours = new();
    List<string> _freeSlots = new();

    int _selectedConsultationHourId = 0;
    DateTime _selectedDate = DateTime.Today;
    string _selectedTime = "";
    string _bookingError = "";
    bool _bookingSuccess = false;
    bool _isBooking = false;

    int? _confirmCancelId = null;
    int? _cancellingId = null;
    string _cancelMessage = "";
    bool _cancelSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        // Sprechstunden laden
        try
        {
            var all = await Http.GetFromJsonAsync<List<ConsultationHourDto>>(
                "http://192.168.68.202:5040/api/consultation-hours");
            _consultationHours = all?.Where(c => c.IsActive).ToList() ?? new();
        }
        catch { }

        // Patient anhand Username laden – IMMER, unabhängig von der Rolle
        if (!string.IsNullOrEmpty(Auth.Username))
        {
            try
            {
                var patient = await Http.GetFromJsonAsync<PatientLookupDto>(
                    $"http://192.168.68.202:5040/api/patients/by-username/{Auth.Username}");

                if (patient != null)
                {
                    _patientId = patient.Id;
                    await LoadMyAppointments();
                }
            }
            catch { }
        }

        _initialized = true;
    }

    async Task LoadMyAppointments()
    {
        if (_patientId == 0) return;
        try
        {
            _appointments = await Http.GetFromJsonAsync<List<PatientAppointmentDto>>(
                $"http://192.168.68.202:5040/api/appointments/patient/{_patientId}") ?? new();
        }
        catch
        {
            _appointments = new();
        }
    }

    async Task LoadFreeSlots()
    {
        if (_selectedConsultationHourId == 0) return;
        _freeSlots = new();
        try
        {
            var dateStr = _selectedDate.ToString("yyyy-MM-dd");
            _freeSlots = await Http.GetFromJsonAsync<List<string>>(
                $"http://192.168.68.202:5040/api/appointments/free-slots/{_selectedConsultationHourId}/{dateStr}")
                ?? new();
        }
        catch { }
    }

    async Task BookAppointment()
    {
        _bookingError = "";
        _bookingSuccess = false;

        if (_patientId == 0)
        {
            _bookingError = "Kein verknüpfter Patient gefunden.";
            return;
        }
        if (_selectedConsultationHourId == 0 || string.IsNullOrEmpty(_selectedTime))
        {
            _bookingError = "Bitte Sprechstunde und Zeitslot wählen.";
            return;
        }

        _isBooking = true;
        try
        {
            var dto = new
            {
                PatientId = _patientId,
                ConsultationHourId = _selectedConsultationHourId,
                Date = _selectedDate,
                Time = TimeSpan.Parse(_selectedTime)
            };

            var response = await Http.PostAsJsonAsync(
                "http://192.168.68.202:5040/api/appointments", dto);

            if (response.IsSuccessStatusCode)
            {
                _bookingSuccess = true;
                _selectedTime = "";
                await LoadFreeSlots();
                await LoadMyAppointments();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _bookingError = body.Contains("Zeitslot")
                    ? "Dieser Zeitslot ist bereits vergeben."
                    : body.Contains("bereits einen Termin")
                        ? "Du hast an diesem Tag bereits einen Termin."
                        : "Fehler beim Buchen.";
            }
        }
        catch (Exception ex)
        {
            _bookingError = $"Netzwerkfehler: {ex.Message}";
        }
        finally
        {
            _isBooking = false;
        }
    }

    void CancelAppointment(int appointmentId)
    {
        _cancelMessage = "";
        _confirmCancelId = appointmentId;
    }

    void DismissCancel() => _confirmCancelId = null;

    async Task ConfirmCancel()
    {
        if (!_confirmCancelId.HasValue) return;

        var id = _confirmCancelId.Value;
        _confirmCancelId = null;
        _cancellingId = id;
        _cancelMessage = "";

        try
        {
            var response = await Http.PostAsync(
                $"http://192.168.68.202:5040/api/appointments/cancel/{id}", null);

            if (response.IsSuccessStatusCode)
            {
                _cancelSuccess = true;
                _cancelMessage = "Termin wurde erfolgreich abgesagt.";
                _appointments.RemoveAll(a => a.Id == id);
                await LoadFreeSlots();
            }
            else
            {
                _cancelSuccess = false;
                _cancelMessage = "Fehler beim Absagen. Bitte erneut versuchen.";
            }
        }
        catch (Exception ex)
        {
            _cancelSuccess = false;
            _cancelMessage = $"Netzwerkfehler: {ex.Message}";
        }
        finally
        {
            _cancellingId = null;
        }
    }

    class PatientAppointmentDto
    {
        public int Id { get; set; }
        public int PatientId { get; set; }
        public int ConsultationHourId { get; set; }
        public DateTime Date { get; set; }
        public TimeSpan Time { get; set; }
        public bool IsCancelled { get; set; }
        public string? ConsultationHourName { get; set; }
        public string? DoctorName { get; set; }
    }

    class ConsultationHourDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; }
    }

    class PatientLookupDto
    {
        public int Id { get; set; }
        public string Username { get; set; } = "";
    }
}