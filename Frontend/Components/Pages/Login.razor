@page "/login"
@using Frontend.Services;
@layout LoginLayout
@inject IAuthService Auth
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (Auth.IsLoggedIn)
        {
            var route = Auth.IsAdmin ? "/admin/users" :
                        Auth.IsDoctor ? "/doctor" :
                        Auth.IsStaff ? "/patient/dashboard" :
                                        "/access-denied";

            Nav.NavigateTo(route, true);
        }
        else
        {
            Nav.NavigateTo("/access-denied", true);
        }
    }
}