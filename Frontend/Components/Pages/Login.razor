@page "/login"
@layout Layout.LoginLayout
@inject NavigationManager Nav
@inject Frontend.Services.AuthService Auth

@code {
    protected override async Task OnInitializedAsync()
    {
        // Kein Login-Dialog mehr – direkt Kerberos prüfen
        await Auth.InitializeAsync();

        if (Auth.IsLoggedIn)
        {
            var route = Auth.IsAdmin ? "/admin/users" :
                        Auth.IsDoctor ? "/doctor" :
                        Auth.IsStaff ? "/patient/dashboard" :
                                        "/access-denied";

            Nav.NavigateTo(route, true);
        }
        else
        {
            Nav.NavigateTo("/access-denied", true);
        }
    }
}