@inherits LayoutComponentBase
@rendermode InteractiveServer
@using Frontend.Services
@inject AuthService Auth
@inject NavigationManager Nav

@if (!_initialized)
{
    <p>Laden...</p>
}
else if (!Auth.IsLoggedIn)
{
    <p>Redirecting...</p>
}
else
{
    <div class="layout">
        <div class="sidebar">
            <div class="sidebar-logo">
                <span>🩺</span>
                <h2>Doctor Panel</h2>
            </div>
            <div class="sidebar-divider"></div>

            <NavLink href="/doctor" class="menu-item" Match="NavLinkMatch.All">
                <span>📅</span> Termine
            </NavLink>
            <NavLink href="/patients" class="menu-item">
                <span>🧑</span> Patienten
            </NavLink>

            @if (Auth.IsAdmin)
            {
                <div class="sidebar-divider"></div>
                <NavLink href="/admin/users" class="menu-item">
                    <span>👥</span> User verwalten
                </NavLink>
                <NavLink href="/admin/appointments/new" class="menu-item">
                    <span>➕</span> Termin vergeben
                </NavLink>
                <NavLink href="/admin/patient" class="menu-item">
                    <span>👥</span> Neue Patienten hinzufügen
                </NavLink>
            }

            <div class="sidebar-bottom">
                <button class="logout-btn" @onclick="Logout">🚪 Abmelden</button>
            </div>
        </div>
        <div class="content">
            @Body
        </div>
    </div>
}

@code {
    bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            _initialized = true;

            if (!Auth.IsLoggedIn)
                Nav.NavigateTo("/login", true);

            StateHasChanged();
        }
    }

    async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }
}