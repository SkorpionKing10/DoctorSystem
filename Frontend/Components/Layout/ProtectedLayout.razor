@inherits LayoutComponentBase
@rendermode InteractiveServer
@using Frontend.Services
@inject IAuthService Auth 
@inject NavigationManager Nav

@if (!_initialized)
{
    <p>Laden...</p>
}
else if (!Auth.IsLoggedIn)
{
    <p style="color:red;">⛔ Kein Zugriff – kein gültiges Kerberos-Ticket.</p>
}
else
{
    <div class="layout">
        <div class="sidebar">
            <div class="sidebar-logo">
                <span>🩺</span>
                <h2>Doctor Panel</h2>
            </div>
            <div class="sidebar-divider"></div>

            @if (Auth.IsStaff)
            {
                <NavLink href="/patient/dashboard" class="menu-item">
                    <span>📅</span> Meine Termine
                </NavLink>
            }

            @if (Auth.IsAdmin || Auth.IsDoctor)
            {
                <NavLink href="/doctor" class="menu-item" Match="NavLinkMatch.All">
                    <span>📅</span> Termine
                </NavLink>
                <NavLink href="/patients" class="menu-item">
                    <span>🧑</span> Patienten
                </NavLink>
            }

            @if (Auth.IsAdmin)
            {
                <div class="sidebar-divider"></div>
                <NavLink href="/admin/users" class="menu-item">
                    <span>👥</span> User verwalten
                </NavLink>
                <NavLink href="/admin/appointments/new" class="menu-item">
                    <span>➕</span> Termin vergeben
                </NavLink>
                <NavLink href="/admin/patient" class="menu-item">
                    <span>👥</span> Neue Patienten hinzufügen
                </NavLink>
            }

            <div class="sidebar-bottom">
                <div style="font-size:13px; color:#aaa; padding:8px;">
                    👤 @Auth.Username<br />
                    <span style="font-size:11px;">@Auth.Role</span>
                </div>
            </div>
        </div>
        <div class="content">
            @Body
        </div>
    </div>
}

@code {
    bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            _initialized = true;

            if (!Auth.IsLoggedIn)
                Nav.NavigateTo("/access-denied", true);

            StateHasChanged();
        }
    }
}